# Example for HAProxy 3.2. Merge into the university's maintained configuration.
# Replace names, certificate and CA paths, and internal IP before validation.
global
    log /dev/log local0
    ssl-default-bind-options ssl-min-ver TLSv1.2
    ssl-default-server-options ssl-min-ver TLSv1.2
    ssl-default-bind-ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256
    ssl-default-server-ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256
    ssl-default-bind-ciphersuites TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256

defaults
    mode http
    log global
    timeout connect 5s
    timeout client 30s
    timeout server 30s
    # Log only the URL path, never OAuth authorization-code query strings.
    log-format "%ci:%cp [%t] %ft %b/%s %ST %B %HM %HP"

frontend website_http
    bind :80
    acl expected_host hdr(host) -i www.example.com
    http-request deny deny_status 421 unless expected_host
    http-request redirect scheme https code 301

frontend website_https
    bind :443 ssl crt /etc/haproxy/certs/www.example.com.pem alpn h2,http/1.1
    acl expected_host hdr(host) -i www.example.com
    http-request deny deny_status 421 unless expected_host
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Host www.example.com
    http-request set-header X-Forwarded-For %[src]
    http-response set-header Strict-Transport-Security "max-age=31536000"
    http-response set-header X-Content-Type-Options nosniff
    http-response set-header Referrer-Policy no-referrer
    http-response set-header Permissions-Policy "camera=(), microphone=(), geolocation=()"
    http-response set-header X-Frame-Options SAMEORIGIN
    # SAMEORIGIN keeps Decap's same-origin preview frames usable.
    default_backend website_internal

backend website_internal
    http-request set-header Host web-internal.example.edu
    option httpchk
    http-check send meth GET uri / ver HTTP/1.1 hdr Host web-internal.example.edu
    http-check expect status 200
    # Encryption also covers the internal hop; never use verify none here.
    server web1 10.20.0.10:8443 ssl verify required ca-file /etc/haproxy/ca/university-ca.pem sni str(web-internal.example.edu) verifyhost web-internal.example.edu check check-sni web-internal.example.edu
